{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 290,
  "data": {
    "url": "data/processed/age.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "percent": "number",
        "table": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "age",
      "type": "ordinal",
      "sort": [
        "≤29",
        "30-39",
        "40-49",
        "50-59",
        "60-68",
        "69+"
      ],
      "title": "Age group",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "percent",
      "type": "quantitative",
      "title": "Share of subgroup (%)",
      "scale": {
        "domain": [
          0,
          35
        ]
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": [
          "School classroom teachers",
          "Casual relief teachers"
        ],
        "range": [
          "#23776f",
          "#c5633f"
        ]
      }
    },
    "tooltip": [
      {
        "field": "group",
        "type": "nominal"
      },
      {
        "field": "age",
        "type": "ordinal"
      },
      {
        "field": "percent",
        "type": "quantitative",
        "format": ".0f",
        "title": "Reported share (%)"
      }
    ]
  },
  "config": {
    "background": "#faf8f2",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#4d5c5a",
      "titleColor": "#263e3b",
      "gridColor": "#e3e5dd",
      "domain": false,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 12,
      "tickCount": 6
    },
    "legend": {
      "orient": "bottom",
      "title": null,
      "labelFontSize": 12,
      "labelLimit": 300
    },
    "range": {
      "category": [
        "#23776f",
        "#c5633f",
        "#a99b65",
        "#617c93"
      ]
    }
  },
  "transform": [
    {
      "calculate": "format(datum.percent,'.0f') + '%'",
      "as": "label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": true,
        "strokeWidth": 3
      }
    },
    {
      "transform": [
        {
          "filter": "datum.age === '69+'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "align": "right",
        "dx": -8,
        "dy": -13
      },
      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "title": {
    "text": "Aged 60+: 41% of relief teachers, 14% of classroom teachers",
    "subtitle": "Reported age-band shares added within each subgroup; percentages are rounded.",
    "anchor": "start",
    "fontSize": 13
  }
}
