{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "params": [
    {
      "name": "mapYear",
      "value": 2025
    },
    {
      "name": "mapSector",
      "value": "All sectors"
    },
    {
      "name": "selectedState",
      "value": "All states"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "center": [
      0,
      -27
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/geo/abs_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e2e7dc",
        "stroke": "#faf8f2"
      }
    },
    {
      "data": {
        "url": "data/processed/state_points.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.state + '|' + mapYear + '|' + mapSector",
          "as": "joinKey"
        },
        {
          "lookup": "joinKey",
          "from": {
            "data": {
              "url": "data/processed/map_values.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "teacher_fte": "number"
                }
              }
            },
            "key": "key",
            "fields": [
              "teacher_fte"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.teacher_fte)",
          "as": "teacher_fte"
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "teacher_fte",
              "as": "total"
            },
            {
              "op": "max",
              "field": "teacher_fte",
              "as": "largest"
            }
          ]
        },
        {
          "calculate": "format(datum.teacher_fte,',.0f')+' FTE · '+format(datum.teacher_fte/datum.total,'.1%')",
          "as": "largestLabel"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#c5633f",
        "stroke": "#faf8f2",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "teacher_fte",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100000
            ],
            "range": [
              0,
              4500
            ]
          },
          "legend": {
            "title": "Teacher FTE",
            "values": [
              10000,
              50000,
              100000
            ],
            "format": "~s"
          }
        },
        "opacity": {
          "condition": {
            "test": "selectedState === 'All states' || datum.state === selectedState",
            "value": 0.8
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal"
          },
          {
            "field": "teacher_fte",
            "type": "quantitative",
            "format": ",.1f",
            "title": "Teacher FTE"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/processed/state_points.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number"
          }
        }
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "dy": -10,
        "stroke": "#faf8f2",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/processed/state_points.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.state + '|' + mapYear + '|' + mapSector",
          "as": "joinKey"
        },
        {
          "lookup": "joinKey",
          "from": {
            "data": {
              "url": "data/processed/map_values.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "teacher_fte": "number"
                }
              }
            },
            "key": "key",
            "fields": [
              "teacher_fte"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.teacher_fte)",
          "as": "teacher_fte"
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "teacher_fte",
              "as": "total"
            },
            {
              "op": "max",
              "field": "teacher_fte",
              "as": "largest"
            }
          ]
        },
        {
          "calculate": "format(datum.teacher_fte,',.0f')+' FTE · '+format(datum.teacher_fte/datum.total,'.1%')",
          "as": "largestLabel"
        },
        {
          "filter": "datum.teacher_fte === datum.largest"
        },
        {
          "calculate": "datum.state + ': ' + datum.largestLabel",
          "as": "callout"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": "bold",
        "fill": "#263e3b"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "callout",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#faf8f2",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#4d5c5a",
      "titleColor": "#263e3b",
      "gridColor": "#e3e5dd",
      "domain": false,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 12,
      "tickCount": 6
    },
    "legend": {
      "orient": "bottom",
      "title": null,
      "labelFontSize": 12,
      "labelLimit": 300
    },
    "range": {
      "category": [
        "#23776f",
        "#c5633f",
        "#a99b65",
        "#617c93"
      ]
    }
  }
}
