{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 290,
  "data": {
    "url": "data/processed/workforce.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "teacher_fte": "number",
        "student_fte": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.state === 'Australia' && datum.sector !== 'All sectors'"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "teacher_fte",
          "as": "nationalTotal"
        }
      ],
      "groupby": [
        "year"
      ]
    },
    {
      "calculate": "datum.teacher_fte / datum.nationalTotal",
      "as": "sectorShare"
    }
  ],
  "mark": "area",
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "axis": {
        "format": "d",
        "tickCount": 6
      },
      "scale": {
        "zero": false
      },
      "title": "Year"
    },
    "y": {
      "field": "teacher_fte",
      "type": "quantitative",
      "stack": "normalize",
      "title": "Share of teacher FTE",
      "axis": {
        "format": ".0%"
      }
    },
    "color": {
      "field": "sector",
      "type": "nominal",
      "scale": {
        "domain": [
          "Government",
          "Catholic",
          "Independent"
        ],
        "range": [
          "#23776f",
          "#c5633f",
          "#a99b65"
        ]
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "quantitative",
        "format": "d"
      },
      {
        "field": "sector",
        "type": "nominal"
      },
      {
        "field": "teacher_fte",
        "type": "quantitative",
        "format": ",.1f",
        "title": "Teacher FTE"
      },
      {
        "field": "sectorShare",
        "type": "quantitative",
        "format": ".1%",
        "title": "Share of national teacher FTE"
      }
    ]
  },
  "config": {
    "background": "#faf8f2",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#4d5c5a",
      "titleColor": "#263e3b",
      "gridColor": "#e3e5dd",
      "domain": false,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 12,
      "tickCount": 6
    },
    "legend": {
      "orient": "bottom",
      "title": null,
      "labelFontSize": 12,
      "labelLimit": 300
    },
    "range": {
      "category": [
        "#23776f",
        "#c5633f",
        "#a99b65",
        "#617c93"
      ]
    }
  },
  "title": {
    "text": [
      "Independent share:",
      "15.3% → 18.8%"
    ],
    "subtitle": "2006–2025 · share of teacher FTE",
    "anchor": "start",
    "fontSize": 13,
    "color": "#23776f"
  }
}
