{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 290,
  "data": {
    "url": "data/processed/workforce.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "teacher_fte": "number",
        "student_fte": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.state === 'Australia' && datum.sector !== 'All sectors'"
    }
  ],
  "mark": {
    "type": "line",
    "strokeWidth": 3,
    "point": {
      "size": 20
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "axis": {
        "format": "d",
        "tickCount": 6
      },
      "scale": {
        "zero": false
      },
      "title": "Year"
    },
    "y": {
      "field": "teacher_fte",
      "type": "quantitative",
      "title": "Teaching staff (FTE)",
      "axis": {
        "format": "~s",
        "values": [
          0,
          50000,
          100000,
          150000,
          200000,
          250000
        ]
      },
      "scale": {
        "domain": [
          0,
          250000
        ],
        "nice": false
      }
    },
    "color": {
      "field": "sector",
      "type": "nominal",
      "scale": {
        "domain": [
          "Government",
          "Catholic",
          "Independent"
        ],
        "range": [
          "#23776f",
          "#c5633f",
          "#a99b65"
        ]
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "quantitative",
        "format": "d"
      },
      {
        "field": "sector",
        "type": "nominal"
      },
      {
        "field": "teacher_fte",
        "type": "quantitative",
        "format": ",.1f",
        "title": "Teacher FTE"
      }
    ]
  },
  "config": {
    "background": "#faf8f2",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#4d5c5a",
      "titleColor": "#263e3b",
      "gridColor": "#e3e5dd",
      "domain": false,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 12,
      "tickCount": 6
    },
    "legend": {
      "orient": "bottom",
      "title": null,
      "labelFontSize": 12,
      "labelLimit": 300
    },
    "range": {
      "category": [
        "#23776f",
        "#c5633f",
        "#a99b65",
        "#617c93"
      ]
    }
  },
  "title": {
    "text": [
      "Government schools remain",
      "the largest employer"
    ],
    "subtitle": "2006–2025 · teacher FTE",
    "anchor": "start",
    "fontSize": 13,
    "color": "#23776f"
  }
}
