{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 270,
  "data": {
    "url": "data/processed/ratios.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "ratio": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.state !== 'Australia' && datum.sector === 'All sectors' && datum.level === 'All Levels'"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "labelAngle": -45
      },
      "title": "Year"
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": [
        "NSW",
        "VIC",
        "QLD",
        "SA",
        "WA",
        "TAS",
        "NT",
        "ACT"
      ],
      "title": null
    },
    "color": {
      "field": "ratio",
      "type": "quantitative",
      "title": "Students per teacher FTE",
      "scale": {
        "scheme": "tealblues",
        "zero": false,
        "domain": [
          10,
          17
        ]
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal"
      },
      {
        "field": "year",
        "type": "quantitative",
        "format": "d"
      },
      {
        "field": "ratio",
        "type": "quantitative",
        "format": ".1f",
        "title": "Students per teacher FTE"
      }
    ],
    "stroke": {
      "condition": {
        "test": "datum.state === 'TAS' && (datum.year === 2006 || datum.year === 2025)",
        "value": "#263e3b"
      },
      "value": "#faf8f2"
    },
    "strokeWidth": {
      "condition": {
        "test": "datum.state === 'TAS' && (datum.year === 2006 || datum.year === 2025)",
        "value": 2
      },
      "value": 1
    }
  },
  "config": {
    "background": "#faf8f2",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#4d5c5a",
      "titleColor": "#263e3b",
      "gridColor": "#e3e5dd",
      "domain": false,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 12,
      "tickCount": 6
    },
    "legend": {
      "orient": "bottom",
      "title": null,
      "labelFontSize": 12,
      "labelLimit": 300
    },
    "range": {
      "category": [
        "#23776f",
        "#c5633f",
        "#a99b65",
        "#617c93"
      ]
    }
  },
  "title": {
    "text": "Ratios fell in every jurisdiction; Tasmania fell most",
    "subtitle": "2006 → 2025 · Tasmania: 14.4 → 11.8 students per teacher FTE (−2.6)",
    "anchor": "start",
    "fontSize": 13
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#faf8f2",
        "strokeWidth": 1
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state === 'TAS' && (datum.year === 2006 || datum.year === 2025)"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#263e3b"
      },
      "encoding": {
        "text": {
          "field": "ratio",
          "type": "quantitative",
          "format": ".1f"
        },
        "stroke": {
          "value": "#faf8f2"
        },
        "strokeWidth": {
          "value": 2
        }
      }
    }
  ]
}
