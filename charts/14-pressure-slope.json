{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/processed/leaving_reasons.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "percent": "number",
        "table": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "(datum.year === 2020 || datum.year === 2024) && (datum.reason === 'Workload' || datum.reason === 'Insufficient pay' || datum.reason === 'Student behaviour' || datum.reason === 'Class size')"
    },
    {
      "calculate": "datum.reason + '  ' + format(datum.percent,'.0f')+'%'",
      "as": "endLabel"
    },
    {
      "calculate": "datum.reason === 'Workload' ? 78 : datum.reason === 'Insufficient pay' ? 57 : datum.reason === 'Student behaviour' ? 47 : 36",
      "as": "labelY"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [
          2020,
          2024
        ],
        "rangeMax": {
          "expr": "max(100, width - 165)"
        }
      },
      "axis": {
        "values": [
          2020,
          2024
        ],
        "format": "d",
        "labelAngle": 0
      },
      "title": null
    },
    "y": {
      "field": "percent",
      "type": "quantitative",
      "title": "Share selecting reason (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "color": {
      "field": "reason",
      "type": "nominal",
      "legend": null
    },
    "tooltip": [
      {
        "field": "reason",
        "type": "nominal"
      },
      {
        "field": "year",
        "type": "quantitative",
        "format": "d"
      },
      {
        "field": "percent",
        "type": "quantitative",
        "title": "Share selecting reason (%)"
      }
    ]
  },
  "config": {
    "background": "#faf8f2",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#4d5c5a",
      "titleColor": "#263e3b",
      "gridColor": "#e3e5dd",
      "domain": false,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 12,
      "tickCount": 6
    },
    "legend": {
      "orient": "bottom",
      "title": null,
      "labelFontSize": 12,
      "labelLimit": 300
    },
    "range": {
      "category": [
        "#23776f",
        "#c5633f",
        "#a99b65",
        "#617c93"
      ]
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 70
        },
        "strokeWidth": 3
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2024"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1
      },
      "encoding": {
        "x2": {
          "datum": 2024.12
        },
        "y2": {
          "field": "labelY"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "datum": 2024.12
        },
        "y": {
          "field": "labelY",
          "type": "quantitative"
        },
        "text": {
          "field": "endLabel",
          "type": "nominal"
        }
      }
    }
  ],
  "title": {
    "text": [
      "Higher than 2020 does not mean",
      "a continuous rise"
    ],
    "subtitle": "Workload fell from 80% in 2021 to 75% in 2024; pay fell from 54% in 2023 to 48% in 2024.",
    "anchor": "start",
    "fontSize": 13
  }
}
