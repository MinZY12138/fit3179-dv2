{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 290,
  "data": {
    "url": "data/processed/ratios.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "ratio": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year === 2025 && datum.state !== 'Australia' && datum.level === 'All Levels' && (datum.sector === 'Government' || datum.sector === 'Non-Government')"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "ratio",
          "as": "hi"
        },
        {
          "op": "min",
          "field": "ratio",
          "as": "lo"
        }
      ],
      "groupby": [
        "state"
      ]
    },
    {
      "calculate": "'Gap ' + format(datum.hi-datum.lo,'.1f')",
      "as": "gapLabel"
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null
    },
    "x": {
      "field": "ratio",
      "type": "quantitative",
      "title": "Students per teacher FTE",
      "scale": {
        "domain": [
          10,
          15
        ]
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal"
      },
      {
        "field": "sector",
        "type": "nominal"
      },
      {
        "field": "ratio",
        "type": "quantitative",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#b6c3be",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "state",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110
      },
      "encoding": {
        "color": {
          "field": "sector",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state === 'WA' && datum.sector === 'Government'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "align": "right",
        "dy": -15,
        "color": "#263e3b"
      },
      "encoding": {
        "text": {
          "field": "gapLabel",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#faf8f2",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#4d5c5a",
      "titleColor": "#263e3b",
      "gridColor": "#e3e5dd",
      "domain": false,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 12,
      "tickCount": 6
    },
    "legend": {
      "orient": "bottom",
      "title": null,
      "labelFontSize": 12,
      "labelLimit": 300
    },
    "range": {
      "category": [
        "#23776f",
        "#c5633f",
        "#a99b65",
        "#617c93"
      ]
    }
  },
  "title": {
    "text": "Sector differences do not all point the same way",
    "subtitle": "Comparison scale starts at 10. Government has the higher ratio in WA; the lower ratio in NT.",
    "anchor": "start",
    "fontSize": 13
  }
}
